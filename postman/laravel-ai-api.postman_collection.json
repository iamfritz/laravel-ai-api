{
    "info": {
        "name": "Laravel AI API",
        "description": "Collection for Laravel blog API with auth, roles, product catalog, and admin endpoints.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "authToken",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"New Admin\",\n  \"email\": \"newadmin@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"admin\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/register",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "register"]
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var json = JSON.parse(responseBody);",
                                    "if (json.token) {",
                                    "    pm.collectionVariables.set('authToken', json.token);",
                                    "}",
                                    ""
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "login"]
                        }
                    }
                },
                {
                    "name": "Get Auth User",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/user",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "user"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Public Blog",
            "item": [
                {
                    "name": "Get Site Info",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/site",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "site"]
                        }
                    }
                },
                {
                    "name": "Get Blog Posts",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blog",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "blog"]
                        }
                    }
                },
                {
                    "name": "Get Blog Post By Slug",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blog/why-laravel-is-great-for-apis",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "api",
                                "blog",
                                "why-laravel-is-great-for-apis"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Product Catalog",
            "item": [
                {
                    "name": "Get Products",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products?page=1",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products"],
                            "query": [{ "key": "page", "value": "1" }]
                        }
                    }
                },
                {
                    "name": "Get Product by Slug",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products/wireless-noise-cancelling-headphones",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "api",
                                "products",
                                "wireless-noise-cancelling-headphones"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Products by Category",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products/category/electronics",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "api",
                                "products",
                                "category",
                                "electronics"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Products by Tag",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products/tag/audio",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products", "tag", "audio"]
                        }
                    }
                },
                {
                    "name": "Get Product Categories",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/product-categories",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "product-categories"]
                        }
                    }
                },
                {
                    "name": "Get Product Tags",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/product-tags",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "product-tags"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Product Management",
            "item": [
                {
                    "name": "List Products (Admin)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products-admin",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products-admin"]
                        }
                    }
                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Studio Speaker\",\n  \"slug\": \"studio-speaker\",\n  \"description\": \"Modern wireless speaker for focused work and rich, room-filling audio.\",\n  \"image\": \"https://images.unsplash.com/photo-1518444065439-e933c06ce9cd?auto=format&fit=crop&w=1200&q=80\",\n  \"sku\": \"STS-2121\",\n  \"price\": 179.99,\n  \"category_id\": 1,\n  \"status\": \"published\",\n  \"tags\": [\"audio\", \"home\"],\n  \"custom_fields\": [\n    {\"key\": \"Battery\", \"value\": \"18 hours\"},\n    {\"key\": \"Connectivity\", \"value\": \"Bluetooth 5.2\"}\n  ],\n  \"variations\": [\n    {\"name\": \"Color\", \"options\": [\"Black\", \"White\"]}\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/products-admin",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products-admin"]
                        }
                    }
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PUT",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Studio Speaker Pro\",\n  \"slug\": \"studio-speaker-pro\",\n  \"price\": 199.99,\n  \"status\": \"published\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/products-admin/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products-admin", "1"]
                        }
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/products-admin/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "products-admin", "1"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Blog Management",
            "item": [
                {
                    "name": "List Posts",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/posts",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "posts"]
                        }
                    }
                },
                {
                    "name": "Create Post",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"New API Post\",\n  \"slug\": \"new-api-post\",\n  \"excerpt\": \"This is a sample post for testing the blog management API.\",\n  \"content\": \"This is the full article content for the new blog post.\",\n  \"status\": \"published\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/posts",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "posts"]
                        }
                    }
                },
                {
                    "name": "Update Post",
                    "request": {
                        "method": "PUT",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Updated API Post\",\n  \"slug\": \"updated-api-post\",\n  \"excerpt\": \"Updated excerpt for the blog post.\",\n  \"content\": \"Updated content for the blog post.\",\n  \"status\": \"published\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/posts/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "posts", "1"]
                        }
                    }
                }
            ]
        }
    ]
}
